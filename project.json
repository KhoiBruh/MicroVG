{
  "warnings": [ " " ],
  "dependency-search-paths": [ "include" ],
  "dependencies": [ "opengl", "glfw34" ],
  "authors": [ "KhoiBruh <github.com/khoibruh>" ],
  "version": "0.1.0",
  "sources": [ "src/**" ],
  "test-sources": [ "test/**" ],
  "build-dir": "build",
  "output": "build",
  "targets": {
    "MicroVG": {
      "type": "executable",
      "linker-search-paths": [ "build/unpacked_c3l/glfw34.c3l/windows-x64" ],
      "linked-libraries": [ "glfw", "gdi32", "user32", "shell32" ]
    }
  },

  "cpu": "generic",
  "opt": "O0"
}
